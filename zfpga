#!/bin/bash
# zfpga -- Zephyr-on-FPGA bring-up CLI (scaffold a sample, flash it with its PL
# bitstream loaded). See `zfpga help`.
set -euo pipefail

TOOL_DIR=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)
export TOOL_DIR
# shellcheck source=lib/common.sh
source "$TOOL_DIR/lib/common.sh"

usage() {
    cat <<EOF
zfpga -- Zephyr-on-FPGA bring-up tooling

Usage:
    zfpga init                       Configure this bench once (SD mux, console).
    zfpga new <board> <sample> [<path>]
                                     Register <sample> for <board>: create its
                                     bitstreams/<sample>/ drop folder + board marker.
                                     <path> records an app outside zephyr/samples/
                                     (e.g. modules/lib/libiio/zephyr/samples/iiod).
    zfpga flash [-p auto|always|never] [-b <board>] [-S <snippet>] [-n] <sample|path> [-- <args>]
                                     Build <sample> and flash it with its PL bitstream.
                                     -p pristine mode, -b board, -S snippet (west-style
                                     flags). A path builds that app; its basename
                                     names the bitstreams/ folder. -n boots
                                     without a PL bitstream (PS-only apps).
                                     Args after '--' pass to west build (e.g.
                                     -- -DEXTRA_CONF_FILE=debug.conf).
    zfpga console [-d <dev>] [-b <baud>] [--no-log] [sample]
                                     Attach to the board UART and tee a
                                     timestamped boot log to logs/. Device/baud
                                     default to CONSOLE_DEV/CONSOLE_BAUD (zfpga init);
                                     falls back to /dev/ttyUSB0, then /dev/ttyACM0.
    zfpga logs [clean [--keep N]]    List captured boot logs, or clean them
                                     (keep the N newest with --keep).
    zfpga doctor                     Preflight the bench: tools, config, SD target.
    zfpga list                       List supported boards.
    zfpga help                       Show this help.

Supported boards: $(list_boards | paste -sd, -)

Workspace is the parent of this tool dir ($WS), override with ZFPGA_WS.
EOF
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift
case "$cmd" in
init)   source "$TOOL_DIR/lib/cmd_init.sh";  cmd_init  "$@" ;;
new)    source "$TOOL_DIR/lib/cmd_new.sh";   cmd_new   "$@" ;;
flash)  source "$TOOL_DIR/lib/cmd_flash.sh"; cmd_flash "$@" ;;
console) source "$TOOL_DIR/lib/cmd_console.sh"; cmd_console "$@" ;;
logs)   source "$TOOL_DIR/lib/cmd_logs.sh"; cmd_logs "$@" ;;
doctor) source "$TOOL_DIR/lib/cmd_doctor.sh"; cmd_doctor "$@" ;;
list)   list_boards ;;
help|-h|--help) usage ;;
*)      die "unknown command '$cmd' (try 'zfpga help')" ;;
esac
