# zynqmp_apu -- ZCU102 (ZynqMP, Cortex-A53). Single-stage boot chain.
# Shared across benches; do NOT put desk-specific paths here (see .flash.local).
BOARD=zynqmp_apu
BOOT_CHAIN=single                 # combined FSBL+PMUFW+TF-A+U-Boot BOOT.BIN
BIT_LOAD=0x2000000                # DDR scratch for the ~14 MB bitstream, clear of Zephyr
REQUIRED_ARTIFACTS="system_top.bit"
# BOOT.BIN is a user build (not shipped): set BOOTBIN_zynqmp_apu in .flash.local.
# See docs/boot-chain.md -- the U-Boot must have fatload + cache control + boot.scr autoboot.
RESET_HINT="press the ZCU102 CPU reset button (POR_B / SW40)"
