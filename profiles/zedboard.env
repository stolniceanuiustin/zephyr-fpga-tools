# zedboard -- Zynq-7000 (Cortex-A9). Two-stage SPL boot chain.
# Shared across benches; do NOT put desk-specific paths here (see .flash.local).
BOARD=zedboard
BOOT_CHAIN=spl                    # BOOT.BIN is the SPL; it FAT-loads u-boot.img as stage 2
BIT_LOAD=0x2000000
REQUIRED_ARTIFACTS="system_top.bit"
# BOOT.BIN (SPL) and u-boot.img are user builds (not shipped): set
# BOOTBIN_zedboard and UBOOT_IMG_zedboard in .flash.local. See docs/boot-chain.md.
RESET_HINT="power-cycle the zedboard"
